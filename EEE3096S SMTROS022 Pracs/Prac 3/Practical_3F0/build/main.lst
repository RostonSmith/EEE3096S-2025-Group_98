 107:Core/Src/main.c ****   /* Infinite loop */
 108:Core/Src/main.c ****   /* USER CODE BEGIN WHILE */
 109:Core/Src/main.c ****   while (1)
 110:Core/Src/main.c ****   {
 111:Core/Src/main.c ****     /* USER CODE END WHILE */
 112:Core/Src/main.c **** 
 113:Core/Src/main.c ****     /* USER CODE BEGIN 3 */
 114:Core/Src/main.c ****     // Visual indicator: Turn on LED0 to signal processing start
 115:Core/Src/main.c ****     HAL_GPIO_WritePin(GPIOB, GPIO_PIN_0, GPIO_PIN_SET);
 116:Core/Src/main.c **** 
 117:Core/Src/main.c ****     // Loop through all max_iter and square sizes
 118:Core/Src/main.c ****     for (int i = 0; i < 3; i++) {           // scale
 119:Core/Src/main.c ****       for (int j = 0; j < 5; j++) {         // sizes (width = height)
 120:Core/Src/main.c ****         int width  = test_sizes[j];
 121:Core/Src/main.c ****         int height = test_sizes[j];
 122:Core/Src/main.c ****         int scale_cur = scale[i];
 123:Core/Src/main.c **** 
 124:Core/Src/main.c ****         start_time = HAL_GetTick();
 125:Core/Src/main.c **** 
 126:Core/Src/main.c ****         // Run Mandelbrot (can keep all three if you want)
 127:Core/Src/main.c ****         checksum = calculate_mandelbrot_fixed_point_arithmetic(width, height, MAX_ITER, scale_cur);
 128:Core/Src/main.c **** //        checksum = calculate_mandelbrot_float(width, height, MAX_ITER);
 129:Core/Src/main.c **** //        checksum = calculate_mandelbrot_double(width, height, MAX_ITER);
 130:Core/Src/main.c **** 
 131:Core/Src/main.c ****         end_time = HAL_GetTick();
 132:Core/Src/main.c ****         execution_time = end_time - start_time;
 133:Core/Src/main.c **** 
 134:Core/Src/main.c ****         // Store results
 135:Core/Src/main.c ****         checksum_results[i][j]       = checksum;
 136:Core/Src/main.c ****         execution_time_results[i][j] = execution_time;
 137:Core/Src/main.c **** 
 138:Core/Src/main.c ****         // Visual indicator: Turn on LED1 to signal processing active
 139:Core/Src/main.c ****         HAL_GPIO_WritePin(GPIOB, GPIO_PIN_1, GPIO_PIN_SET);
 140:Core/Src/main.c **** 
 141:Core/Src/main.c ****         HAL_Delay(100); // short pause for visual feedback
 142:Core/Src/main.c **** 
 143:Core/Src/main.c ****         // Turn OFF LED1 between tests
 144:Core/Src/main.c ****         HAL_GPIO_WritePin(GPIOB, GPIO_PIN_1, GPIO_PIN_RESET);
 145:Core/Src/main.c ****       }
 146:Core/Src/main.c ****       HAL_GPIO_WritePin(GPIOB, GPIO_PIN_2, GPIO_PIN_SET);
 147:Core/Src/main.c **** 

 112:Core/Src/main.c ****   {
 113:Core/Src/main.c ****     /* USER CODE END WHILE */
 114:Core/Src/main.c **** 
 115:Core/Src/main.c ****     /* USER CODE BEGIN 3 */
 116:Core/Src/main.c ****     // Visual indicator: Turn on LED0 to signal processing start
 117:Core/Src/main.c ****     HAL_GPIO_WritePin(GPIOB, GPIO_PIN_0, GPIO_PIN_SET);
 118:Core/Src/main.c **** 
 119:Core/Src/main.c ****     // Loop through all max_iter and square sizes
 120:Core/Src/main.c ****     for (int i = 0; i < 3; i++) {           // scale
 121:Core/Src/main.c ****       for (int j = 0; j < 5; j++) {         // sizes (width = height)
 122:Core/Src/main.c ****         int width  = test_sizes[j];
 123:Core/Src/main.c ****         int height = test_sizes[j];
 124:Core/Src/main.c ****         int scale_cur = scale[i];
 125:Core/Src/main.c **** 
 126:Core/Src/main.c ****         start_time = HAL_GetTick();
 127:Core/Src/main.c **** 
 128:Core/Src/main.c ****         // Run Mandelbrot (can keep all three if you want)
 129:Core/Src/main.c ****         checksum = calculate_mandelbrot_fixed_point_arithmetic(width, height, MAX_ITER, scale_cur);
 130:Core/Src/main.c **** //        checksum = calculate_mandelbrot_float(width, height, MAX_ITER);
 131:Core/Src/main.c **** //        checksum = calculate_mandelbrot_double(width, height, MAX_ITER);
 132:Core/Src/main.c **** 
 133:Core/Src/main.c ****         end_time = HAL_GetTick();
 134:Core/Src/main.c ****         execution_time = end_time - start_time;
 135:Core/Src/main.c **** 
 136:Core/Src/main.c ****         // Store results
 137:Core/Src/main.c ****         checksum_results[i][j]       = checksum;
 138:Core/Src/main.c ****         execution_time_results[i][j] = execution_time;
 139:Core/Src/main.c **** 
 140:Core/Src/main.c ****         // Visual indicator: Turn on LED1 to signal processing active
 141:Core/Src/main.c ****         HAL_GPIO_WritePin(GPIOB, GPIO_PIN_1, GPIO_PIN_SET);
 142:Core/Src/main.c **** 
 143:Core/Src/main.c ****         HAL_Delay(100); // short pause for visual feedback
 144:Core/Src/main.c **** 
 145:Core/Src/main.c ****         // Turn OFF LED1 between tests
ARM GAS  C:\Users\rosto\AppData\Local\Temp\cceCYCFk.s 			page 4


 146:Core/Src/main.c ****         HAL_GPIO_WritePin(GPIOB, GPIO_PIN_1, GPIO_PIN_RESET);
 147:Core/Src/main.c ****       }
 148:Core/Src/main.c ****       HAL_GPIO_WritePin(GPIOB, GPIO_PIN_2, GPIO_PIN_SET);
 149:Core/Src/main.c **** 
 150:Core/Src/main.c ****       HAL_Delay(100);
 151:Core/Src/main.c **** 
 152:Core/Src/main.c ****       HAL_GPIO_WritePin(GPIOB, GPIO_PIN_2, GPIO_PIN_RESET);
 153:Core/Src/main.c ****     }
 154:Core/Src/main.c ****     HAL_GPIO_WritePin(GPIOB, GPIO_PIN_3, GPIO_PIN_SET);
 155:Core/Src/main.c **** 
 156:Core/Src/main.c ****     // Keep LED0 ON for 2s after completing all tests
 157:Core/Src/main.c ****     HAL_Delay(2000);
 158:Core/Src/main.c **** 
 159:Core/Src/main.c ****     // Turn OFF all LEDs
 160:Core/Src/main.c ****     HAL_GPIO_WritePin(GPIOB, GPIO_PIN_0|GPIO_PIN_3, GPIO_PIN_RESET);
 161:Core/Src/main.c **** 
